# Signing for the TestFlight workflow (.github/workflows/testflight.yml).
#
# The distribution certificate is a long-lived one, kept in the repository's
# secrets and imported into a keychain by the workflow. Only the provisioning
# profile is made here, fresh for each run.

default_platform(:ios)

BUNDLE_ID = "games.javier.memo"
PROFILE_NAME = "Memo CI"
DEVICE_PROFILE_NAME = "Memo Device"

# A build for one registered device, pointed at CloudKit's development
# database. See the `destination` input of the TestFlight workflow.
def device_build?
  ENV["DESTINATION"] == "device"
end

def profile_name
  device_build? ? DEVICE_PROFILE_NAME : PROFILE_NAME
end

def connect_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

# For the calls made to App Store Connect directly rather than through an
# action.
def connect_spaceship
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    filepath: ENV.fetch("ASC_KEY_PATH")
  )
end

# The App Store Connect ID of the certificate the workflow imported, found by
# its serial number so the profile is tied to that certificate and no other.
# Nil if it cannot be found, which leaves the choice to sigh.
def stored_certificate_id
  normalize = ->(serial) { serial.to_s.upcase.sub(/\A0+/, "") }
  wanted = normalize.call(ENV["SIGNING_CERT_SERIAL"])
  return nil if wanted.empty?

  connect_spaceship
  match = Spaceship::ConnectAPI::Certificate.all.find do |certificate|
    normalize.call(certificate.serial_number) == wanted
  end

  UI.important("The stored certificate was not found in App Store Connect") if match.nil?
  match&.id
end

def delete_profiles(names)
  connect_spaceship

  names.each do |name|
    Spaceship::ConnectAPI::Profile.all(filter: { name: name }).each do |profile|
      profile.delete!
      UI.message("Deleted profile #{profile.name}")
    end
  end
end

lane :create_profile do
  connect_api_key

  if device_build?
    register_device(name: "Memo test device", udid: ENV.fetch("DEVICE_UDID"))
  end

  sigh(
    app_identifier: BUNDLE_ID,
    provisioning_name: profile_name,
    adhoc: device_build?,
    cert_id: stored_certificate_id,
    force: true,
    skip_install: true,
    output_path: ENV.fetch("SIGNING_DIR"),
    filename: "Memo.mobileprovision"
  )
end

lane :remove_profile do
  delete_profiles([profile_name])
end

# Revokes one certificate by ID and deletes both profiles. Only for clearing
# out certificates left by the earlier one-per-build scheme; see the Revoke
# Signing Certificate workflow.
lane :remove_signing do
  delete_profiles([PROFILE_NAME, DEVICE_PROFILE_NAME])

  cert_id = ENV["SIGNING_CERT_ID"].to_s
  unless cert_id.empty?
    Spaceship::ConnectAPI::Certificate.all.select { |c| c.id == cert_id }.each do |certificate|
      certificate.delete!
      UI.message("Revoked certificate #{certificate.id}")
    end
  end
end
